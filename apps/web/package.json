{
  "name": "@chill-club/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.prisma && node scripts/verify-prisma-client.cjs && next build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node ../../scripts/run-node-tests.mjs features lib",
    "monitor:site": "playwright test -c playwright.monitoring.config.ts",
    "monitor:site:headed": "playwright test -c playwright.monitoring.config.ts --headed",
    "monitor:site:report": "playwright show-report playwright-report",
    "perf:http-baseline": "node scripts/run-http-load-baseline.mjs",
    "redis:check": "node scripts/check-upstash-redis.mjs",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && node scripts/verify-prisma-client.cjs",
    "verify:prisma-client": "node scripts/verify-prisma-client.cjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-planets": "tsx prisma/seed-planets.ts",
    "db:copy-public-content": "tsx prisma/copy-public-content.ts",
    "db:backfill-ticket-links": "tsx prisma/backfill-open-data-ticket-links.ts",
    "db:migrate-legacy-public-events": "tsx prisma/migrate-legacy-activity-info-to-public-events.ts"
  },
  "dependencies": {
    "@capacitor/push-notifications": "^7.0.7",
    "@capawesome/capacitor-badge": "^7.0.1",
    "@chill-club/shared": "file:../../packages/shared",
    "@chill-club/ui": "file:../../packages/ui",
    "@clerk/nextjs": "^6.12.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.2.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.4",
    "next-intl": "^3.26.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@capacitor/core": "^7.6.7",
    "@capacitor/ios": "^7.6.7",
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
