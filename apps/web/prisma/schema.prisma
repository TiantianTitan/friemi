  createdAt     DateTime      @default(now())

  @@unique([transactionId, participantId])
  @@index([participantId, transactionId])
}

model AaAttachment {
  id                    String             @id @default(cuid())
  transactionId         String
  transaction           AaTransaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  uploaderParticipantId String
  uploader              AaParticipant      @relation(fields: [uploaderParticipantId], references: [id], onDelete: Restrict)
  objectKey             String             @unique
  fileName              String             @db.VarChar(180)
  mimeType              String             @db.VarChar(100)
  byteSize              Int
  status                AaAttachmentStatus @default(UPLOADING)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([transactionId, createdAt])
  @@index([uploaderParticipantId, createdAt])
}

model AaTransactionRevision {
  id                 String        @id @default(cuid())
  transactionId      String
  transaction        AaTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  version            Int
  actorParticipantId String
  actor              AaParticipant @relation(fields: [actorParticipantId], references: [id], onDelete: Restrict)
  snapshot           Json
  changeSummary      String?       @db.VarChar(240)
  createdAt          DateTime      @default(now())

  @@unique([transactionId, version])
  @@index([actorParticipantId, createdAt])
}

model AaChangeRequest {
  id                      String                @id @default(cuid())
  transactionId           String
  transaction             AaTransaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actorParticipantId      String
  actor                   AaParticipant         @relation("AaChangeRequestActor", fields: [actorParticipantId], references: [id], onDelete: Restrict)
  expectedVersion         Int
  proposedPayload         Json
  status                  AaChangeRequestStatus @default(PENDING)
  reviewedByParticipantId String?
  reviewer                AaParticipant?        @relation("AaChangeRequestReviewer", fields: [reviewedByParticipantId], references: [id], onDelete: SetNull)
  reviewedAt              DateTime?
  rejectionReason         String?               @db.VarChar(240)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([transactionId, status, createdAt])
  @@index([actorParticipantId, status, createdAt])
  @@index([reviewedByParticipantId, createdAt])
}

model AaConflict {
  id                      String           @id @default(cuid())
  transactionId           String
  transaction             AaTransaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  clientVersion           Int
  serverVersion           Int
  proposedPayload         Json
  status                  AaConflictStatus @default(OPEN)
  resolvedByParticipantId String?
  resolver                AaParticipant?   @relation("AaConflictResolver", fields: [resolvedByParticipantId], references: [id], onDelete: SetNull)
  resolvedAt              DateTime?
  createdAt               DateTime         @default(now())

  @@index([transactionId, status, createdAt])
  @@index([resolvedByParticipantId, createdAt])
}

model AaPaymentRequest {
  id                     String                 @id @default(cuid())
  ledgerId               String
  ledger                 AaLedger               @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  fromParticipantId      String
  fromParticipant        AaParticipant          @relation("AaPaymentRequestFrom", fields: [fromParticipantId], references: [id], onDelete: Restrict)
  toParticipantId        String
  toParticipant          AaParticipant          @relation("AaPaymentRequestTo", fields: [toParticipantId], references: [id], onDelete: Restrict)
  amountMinor            BigInt
  currency               String                 @db.Char(3)
  ledgerVersion          Int
  status                 AaPaymentRequestStatus @default(DRAFT)
  createdByParticipantId String
  creator                AaParticipant          @relation("AaPaymentRequestCreator", fields: [createdByParticipantId], references: [id], onDelete: Restrict)
  linkedTransferId       String?                @unique
  linkedTransfer         AaTransaction?         @relation("AaPaymentRequestTransfer", fields: [linkedTransferId], references: [id], onDelete: SetNull)
  sentAt                 DateTime?
  viewedAt               DateTime?
  expiresAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([ledgerId, status, updatedAt])
  @@index([fromParticipantId, status])
  @@index([toParticipantId, status])
}

model AaAuditEvent {
  id                 String         @id @default(cuid())
  ledgerId           String
  ledger             AaLedger       @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transactionId      String?
  transaction        AaTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  actorParticipantId String?
  actor              AaParticipant? @relation(fields: [actorParticipantId], references: [id], onDelete: SetNull)
  action             String         @db.VarChar(60)
  entityType         String         @db.VarChar(40)
  entityId           String
  before             Json?
  after              Json?
  createdAt          DateTime       @default(now())

  @@index([ledgerId, createdAt])
  @@index([transactionId, createdAt])
  @@index([actorParticipantId, createdAt])
}

model UserFollow {
  id          String      @id @default(cuid())
  followerId  String
  followingId String
  follower    UserProfile @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   UserProfile @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model UserProfileRemark {
  id         String      @id @default(cuid())
  ownerId    String
  targetId   String
  remarkName String      @db.VarChar(32)
  owner      UserProfile @relation("UserProfileRemarkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  target     UserProfile @relation("UserProfileRemarkTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([ownerId, targetId])
  @@index([targetId])
}

model FriendRequest {
  id             String              @id @default(cuid())
  requesterId    String
  receiverId     String
  pendingPairKey String?             @unique
  status         FriendRequestStatus @default(PENDING)
  message        String?
  requester      UserProfile         @relation("FriendRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver       UserProfile         @relation("FriendRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  respondedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([requesterId, status, createdAt])
  @@index([receiverId, status, createdAt])
  @@index([requesterId, receiverId, status])
}

model Friendship {
  id        String      @id @default(cuid())
  userAId   String
  userBId   String
  userA     UserProfile @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     UserProfile @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Conversation {
  id            String                   @id @default(cuid())
  userAId       String
  userBId       String
  userA         UserProfile              @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         UserProfile              @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      DirectMessage[]
  preferences   ConversationPreference[]
  lastMessageAt DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@index([lastMessageAt])
}

model ConversationPreference {
  id             String       @id @default(cuid())
  conversationId String
  profileId      String
  mutedAt        DateTime?
  pinnedAt       DateTime?
  hiddenAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  profile        UserProfile  @relation("ConversationPreferenceProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, profileId])
  @@index([profileId, mutedAt])
  @@index([profileId, pinnedAt])
  @@index([profileId, hiddenAt])
  @@index([conversationId, mutedAt])
}

model DirectMessage {
  id             String                  @id @default(cuid())
  conversationId String
  senderId       String
  activityId     String?
  body           String
  imageUrls      String[]                @default([])
  readAt         DateTime?
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         UserProfile             @relation("DirectMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  activity       Activity?               @relation(fields: [activityId], references: [id], onDelete: SetNull)
  deletions      DirectMessageDeletion[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([conversationId, createdAt])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, updatedAt])
  @@index([conversationId, senderId, readAt])
  @@index([senderId, createdAt])
  @@index([activityId])
}

model DirectMessageDeletion {
  id        String        @id @default(cuid())
  messageId String
  profileId String
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  profile   UserProfile   @relation("DirectMessageDeletionProfile", fields: [profileId], references: [id], onDelete: Cascade)
  deletedAt DateTime      @default(now())

  @@unique([messageId, profileId])
  @@index([profileId, deletedAt])
  @@index([profileId, deletedAt, messageId])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  name          String
  environment   String
  userProfileId String?
  anonymousId   String?
  sessionId     String?
  locale        String
  route         String
  referrer      String?
  userAgent     String?
  deviceType    String?
  sourceSurface String?
  entityType    String?
  entityId      String?
  appVersion    String?
  properties    Json?
  createdAt     DateTime @default(now())

  @@index([name, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([userProfileId, createdAt])
  @@index([sourceSurface, createdAt])
  @@index([environment, createdAt])
}

model GameToolRoom {
  id            String                 @id @default(cuid())
  kind          GameToolKind           @default(AVALON)
  status        GameToolRoomStatus     @default(LOBBY)
  code          String                 @unique @db.VarChar(8)
  locale        String                 @default("zh-CN")
  title         String
  mode          String                 @default("identity")
  playerCount   Int                    @default(7)
  hostId        String
  host          UserProfile            @relation("GameToolRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  config        Json?
  state         Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  cancelledAt   DateTime?
  revision      Int                    @default(0)
  seats         GameToolSeat[]
  members       GameToolRoomMember[]
  events        GameToolEvent[]
  submissions   GameToolSubmission[]
  playerRecords GameToolPlayerRecord[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([hostId, createdAt])
  @@index([kind, status, updatedAt])
  @@index([code])
}

model GameToolRoomMember {
  id           String        @id @default(cuid())
  roomId       String
  room         GameToolRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profileId    String?
  profile      UserProfile?  @relation("GameToolRoomMemberProfile", fields: [profileId], references: [id], onDelete: SetNull)
  guestName    String?
  memberToken  String        @unique @db.VarChar(32)
  seatedSeatId String?
  seatedSeat   GameToolSeat? @relation("GameToolRoomMemberSeat", fields: [seatedSeatId], references: [id], onDelete: SetNull)
  readyAt      DateTime?
  lastSeenAt   DateTime      @default(now())
  leftAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([roomId, profileId])
  @@unique([seatedSeatId])
  @@index([roomId, lastSeenAt])
  @@index([profileId])
}

model GameToolSeat {
  id             String               @id @default(cuid())
  roomId         String
  profileId      String?
  privateToken   String               @unique @db.VarChar(32)
  seatNumber     Int
  displayName    String
  guestName      String?
  roleKey        String?
  roleAlignment  String?
  privatePayload Json?
  readyAt        DateTime?
  joinedAt       DateTime             @default(now())
  leftAt         DateTime?
  room           GameToolRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomMember     GameToolRoomMember?  @relation("GameToolRoomMemberSeat")
  profile        UserProfile?         @relation("GameToolSeatProfile", fields: [profileId], references: [id], onDelete: SetNull)
  submissions    GameToolSubmission[]

  @@unique([roomId, seatNumber])
  @@unique([roomId, profileId])
  @@index([profileId, joinedAt])
  @@index([roomId, readyAt])
}

model GameToolEvent {
  id        String       @id @default(cuid())
  roomId    String
  actorId   String?
  type      String
  payload   Json?
  room      GameToolRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actor     UserProfile? @relation("GameToolEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([roomId, createdAt])
  @@index([actorId, createdAt])
  @@index([type, createdAt])
}

model GameToolSubmission {
  id          String                 @id @default(cuid())
  roomId      String
  seatId      String?
  profileId   String?
  roundIndex  Int                    @default(0)
  kind        GameToolSubmissionKind
  value       String
  metadata    Json?
  submittedAt DateTime               @default(now())
  room        GameToolRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seat        GameToolSeat?          @relation(fields: [seatId], references: [id], onDelete: SetNull)
  profile     UserProfile?           @relation("GameToolSubmissionProfile", fields: [profileId], references: [id], onDelete: SetNull)

  @@unique([roomId, roundIndex, kind, seatId])
  @@index([roomId, kind, roundIndex])
  @@index([profileId, submittedAt])
}

model GameToolPlayerRecord {
  id            String       @id @default(cuid())
  roomId        String
  profileId     String
  kind          GameToolKind
  variantKey    String?
  variantName   String?
  seatNumber    Int?
  roleKey       String?
  roleAlignment String?
  result        String?
  isJudge       Boolean      @default(false)
  playedAt      DateTime     @default(now())
  metadata      Json?
  room          GameToolRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  profile       UserProfile  @relation("GameToolPlayerRecordProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([roomId, profileId])
  @@index([profileId, kind, playedAt])
  @@index([roomId])
}
