generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ActivityType {
  PUBLIC_EVENT
  USER_HOSTED
  LOCAL
  TRIP
}

enum ActivityCategory {
  FOOD
  WANDER
  AUDIO_VISUAL
  ART
  BOARD_GAME
  GROWTH
  TRAVEL
  MUSIC
  SPORTS
  OTHER
}

enum PriceType {
  FREE
  AA
  FIXED
  RANGE
}

enum ActivityStatus {
  OPEN
  FULL
  DRAFT
  RECRUITING
  CONFIRMED
  ENDED
  CANCELLED
}

enum ActivityVisibility {
  PUBLIC
  LINK_ONLY
  PRIVATE
}

enum PublicEventStatus {
  SCHEDULED
  CANCELLED
}

enum ActivityPriorityTargetType {
  ACTIVITY
  PUBLIC_EVENT
}

enum ParticipantStatus {
  JOINED
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum UserProfileStatus {
  ACTIVE
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum UserPresenceStatus {
  ONLINE
  AWAY
  INVISIBLE
}

enum TrustScoreEventType {
  ACTIVITY_CHECK_IN
  INVITE_FRIEND
  PHONE_VERIFIED
  CLEAN_HALF_YEAR
  NO_SHOW
  USER_REPORT
  MASS_REPORT
  HARASSMENT_DM
  ORGANIZER_REPORT
}

enum CharmGiftSurface {
  PROFILE
  ACTIVITY
  MOMENT
  PLANET
  DIRECT_MESSAGE
  SYSTEM
  OTHER
}

enum FriemiCheckType {
  WELCOME
  BLIND_BOX
}

enum FriemiCheckStatus {
  AVAILABLE
  REDEEMED
  EXPIRED
}

enum FriemiCoinTransactionType {
  CHECK_REDEEMED
  RECHARGE
  GIFT_SENT
  GIFT_REFUNDED
  MANUAL_ADJUSTMENT
}

enum BlindBoxFragmentEventType {
  SUCCESSFUL_ACTIVITY
  MANUAL_ADJUSTMENT
}

enum MobilePlatform {
  ANDROID
  IOS
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum CommentType {
  QUESTION
  SUGGESTION
  REVIEW
}

enum NotificationType {
  PARTICIPATION_PENDING
  PARTICIPATION_CONFIRMED
  PARTICIPATION_CANCELLED
  PARTICIPATION_APPROVED
  PARTICIPATION_REJECTED
  ACTIVITY_UPDATED
  ACTIVITY_CANCELLED
  ACTIVITY_ANNOUNCEMENT
  ACTIVITY_CHECK_IN
  FRIEND_REQUEST
  ACTIVITY_COMMENTED
  COMMENT_REPLY
  DIRECT_MESSAGE
  MOMENT_LIKED
  MOMENT_COMMENTED
  MOMENT_COMMENT_REPLY
  MOMENT_REPOSTED
  CHARM_GIFT_RECEIVED
  REPORT_CREATED
  PLANET_MESSAGE
  ACTIVITY_ROOM_MESSAGE
  PLANET_JOIN_REQUEST
  AA_REVIEW_REQUIRED
  AA_ENTRY_UPDATED
  AA_TRANSFER_CONFIRMATION
  AA_DISPUTE_OPENED
  AA_PAYMENT_REQUEST
}

enum ReportTargetType {
  USER_PROFILE
  PUBLIC_EVENT
  ACTIVITY
  COMMENT
  MOMENT
  MOMENT_COMMENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_CONTENT
  MISLEADING_INFORMATION
  SAFETY_CONCERN
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum MomentVisibility {
  FRIENDS
  PUBLIC
}

enum PlanetVisibility {
  PUBLIC
  PRIVATE
}

enum PlanetMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlanetMembershipStatus {
  PENDING
  APPROVED
}

enum GameToolKind {
  AVALON
  STORYTELLER
  WEREWOLF
}

enum GameToolRoomStatus {
  LOBBY
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum AaLedgerStatus {
  ACTIVE
  FROZEN
  ARCHIVED
}

enum AaParticipantRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum AaParticipantStatus {
  ACTIVE
  INACTIVE
}

enum AaTransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum AaTransactionStatus {
  PENDING_REVIEW
  POSTED
  REJECTED
  PENDING_CONFIRMATION
  DISPUTED
  VOIDED
}

enum AaSplitMode {
  EQUAL
  WEIGHT
  PERCENT
  CUSTOM
}

enum AaAttachmentStatus {
  UPLOADING
  READY
  FAILED
}

enum AaPaymentRequestStatus {
  DRAFT
  SENT
  VIEWED
  DECLINED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum AaConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AaChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GameToolSubmissionKind {
  TEAM_VOTE
  MISSION_CARD
  ASSASSINATION_TARGET
}

model UserProfile {
  id                      String                        @id @default(cuid())
  clerkUserId             String                        @unique
  email                   String?
  emailVerifiedAt         DateTime?
  contactEmail            String?
  normalizedContactEmail  String?
  phone                   String?
  normalizedPhone         String?
  friendCode              String?                       @unique @db.Char(6)
  nickname                String
  nicknameChangedAt       DateTime?
  firstName               String?
  lastName                String?
  username                String?
  wechatId                String?
  normalizedWechatId      String?
  guestLinkFingerprint    String?
  guestLinkCheckedAt      DateTime?
  guestLinkLastLinkedAt   DateTime?
  avatarUrl               String?
  bio                     String?
  homeCity                String?                       @default("Paris")
  interests               String[]                      @default([])
  status                  UserProfileStatus             @default(ACTIVE)
  presenceStatus          UserPresenceStatus            @default(ONLINE)
  lastActiveAt            DateTime?
  role                    UserRole                      @default(USER)
  isCoCreator             Boolean                       @default(false)
  lastSignInAt            DateTime?
  clerkCreatedAt          DateTime?
  clerkUpdatedAt          DateTime?
  clerkDeletedAt          DateTime?
  syncedAt                DateTime?
  activities              Activity[]                    @relation("ActivityOrganizer")
  managedActivities       ActivityCoManager[]           @relation("ActivityCoManagerProfile")
  addedCoManagers         ActivityCoManager[]           @relation("ActivityCoManagerAddedBy")
  activityManagementLogs  ActivityManagementLog[]       @relation("ActivityManagementLogActor")
  participations          ActivityParticipant[]
  guestParticipations     GuestActivityParticipant[]    @relation("GuestLinkedUser")
  comments                Comment[]
  moments                 Moment[]                      @relation("MomentAuthor")
  momentLikes             MomentLike[]                  @relation("MomentLikeUser")
  momentComments          MomentComment[]               @relation("MomentCommentAuthor")
  notifications           Notification[]                @relation("NotificationRecipient")
  sentNotifications       Notification[]                @relation("NotificationActor")
  officialMessages        OfficialMessage[]             @relation("OfficialMessageAuthor")
  officialReadState       OfficialMessageReadState?
  favoriteActivities      ActivityFavorite[]
  following               UserFollow[]                  @relation("UserFollowing")
  followers               UserFollow[]                  @relation("UserFollowers")
  profileRemarksOwned     UserProfileRemark[]           @relation("UserProfileRemarkOwner")
  profileRemarksReceived  UserProfileRemark[]           @relation("UserProfileRemarkTarget")
  sentFriendRequests      FriendRequest[]               @relation("FriendRequestRequester")
  receivedFriendRequests  FriendRequest[]               @relation("FriendRequestReceiver")
  friendshipsAsUserA      Friendship[]                  @relation("FriendshipUserA")
  friendshipsAsUserB      Friendship[]                  @relation("FriendshipUserB")
  conversationsAsUserA    Conversation[]                @relation("ConversationUserA")
  conversationsAsUserB    Conversation[]                @relation("ConversationUserB")
  conversationPreferences ConversationPreference[]      @relation("ConversationPreferenceProfile")
  sentDirectMessages      DirectMessage[]               @relation("DirectMessageSender")
  directMessageDeletions  DirectMessageDeletion[]       @relation("DirectMessageDeletionProfile")
  activityRoomMessages    ActivityRoomMessage[]         @relation("ActivityRoomMessageSender")
  deletedRoomMessages     ActivityRoomMessage[]         @relation("ActivityRoomMessageDeletedBy")
  activityRoomReadStates  ActivityRoomReadState[]       @relation("ActivityRoomReadStateProfile")
  achievements            UserAchievement[]
  equippedAchievements    UserEquippedAchievement[]
  sentReferrals           UserReferral[]                @relation("UserReferralInviter")
  receivedReferral        UserReferral?                 @relation("UserReferralInvitee")
  profileVisitsReceived   ProfileVisit[]                @relation("ProfileVisitTarget")
  profileVisitsMade       ProfileVisit[]                @relation("ProfileVisitVisitor")
  authoredAnnouncements   ActivityAnnouncement[]        @relation("ActivityAnnouncementAuthor")
  submittedReports        Report[]                      @relation("ReportReporter")
  reviewedReports         Report[]                      @relation("ReportReviewer")
  mobileDevices           MobileDevice[]
  trustScoreEvents        TrustScoreEvent[]
  charmBalance            UserCharmBalance?
  sentCharmGiftEvents     CharmGiftEvent[]              @relation("CharmGiftSender")
  receivedCharmGiftEvents CharmGiftEvent[]              @relation("CharmGiftRecipient")
  friemiChecks            FriemiCheck[]
  friemiCoinBalance       UserFriemiCoinBalance?
  friemiCoinTransactions  FriemiCoinTransaction[]
  blindBoxFragmentBalance UserBlindBoxFragmentBalance?
  blindBoxFragmentEvents  BlindBoxFragmentEvent[]
  hostedGameToolRooms     GameToolRoom[]                @relation("GameToolRoomHost")
  gameToolRoomMembers     GameToolRoomMember[]          @relation("GameToolRoomMemberProfile")
  gameToolSeats           GameToolSeat[]                @relation("GameToolSeatProfile")
  reviewedCheckIns        ActivityParticipant[]         @relation("ActivityCheckInReviewer")
  aaLedgersCreated        AaLedger[]                    @relation("AaLedgerCreator")
  aaParticipations        AaParticipant[]               @relation("AaParticipantProfile")
  gameToolEvents          GameToolEvent[]               @relation("GameToolEventActor")
  gameToolSubmissions     GameToolSubmission[]          @relation("GameToolSubmissionProfile")
  gameToolPlayerRecords   GameToolPlayerRecord[]        @relation("GameToolPlayerRecordProfile")
  ownedPlanets            Planet[]                      @relation("PlanetOwner")
  planetMemberships       PlanetMember[]
  planetMessages          PlanetMessage[]               @relation("PlanetMessageAuthor")
  planetChatReadStates    PlanetChatReadState[]         @relation("PlanetChatReadStateProfile")
  planetMoments           PlanetMoment[]                @relation("PlanetMomentAuthor")
  planetMomentComments    PlanetMomentComment[]         @relation("PlanetMomentCommentAuthor")
  planetMomentLikes       PlanetMomentLike[]            @relation("PlanetMomentLikeProfile")
  planetCommentLikes      PlanetMomentCommentLike[]     @relation("PlanetCommentLikeProfile")
  activityPriorityUpdates ActivityPriorityOverride[]    @relation("ActivityPriorityOverrideUpdatedBy")
  activityPriorityLogs    ActivityPriorityOverrideLog[] @relation("ActivityPriorityOverrideLogActor")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  publicEventFavorites    PublicEventFavorite[]

  @@index([nickname])
  @@index([normalizedContactEmail])
  @@index([normalizedPhone])
  @@index([normalizedWechatId])
  @@index([isCoCreator, status])
  @@index([role, status])
  @@index([presenceStatus, lastActiveAt])
}

model Planet {
  id               String                @id @default(cuid())
  slug             String                @unique
  inviteCode       String                @unique @db.VarChar(16)
  name             String
  nameTranslations Json?
  description      String?               @db.Text
  coverImageUrl    String?
  tags             String[]              @default([])
  visibility       PlanetVisibility      @default(PUBLIC)
  ownerId          String
  owner            UserProfile           @relation("PlanetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          PlanetMember[]
  messages         PlanetMessage[]
  chatReadStates   PlanetChatReadState[]
  moments          PlanetMoment[]
  notifications    Notification[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([visibility, createdAt])
  @@index([ownerId, createdAt])
}

model PlanetMember {
  id        String                 @id @default(cuid())
  planetId  String
  profileId String
  role      PlanetMemberRole       @default(MEMBER)
  status    PlanetMembershipStatus @default(APPROVED)
  planet    Planet                 @relation(fields: [planetId], references: [id], onDelete: Cascade)
  profile   UserProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  joinedAt  DateTime               @default(now())

  @@unique([planetId, profileId])
  @@index([planetId, status, joinedAt])
  @@index([profileId, joinedAt])
}

model PlanetMessage {
  id                  String      @id @default(cuid())
  planetId            String
  authorId            String
  content             String      @db.Text
  imageUrls           String[]    @default([])
  mentionedProfileIds String[]    @default([])
  mentionLabels       String[]    @default([])
  mentionsEveryone    Boolean     @default(false)
  planet              Planet      @relation(fields: [planetId], references: [id], onDelete: Cascade)
  author              UserProfile @relation("PlanetMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([planetId, createdAt])
  @@index([planetId, createdAt, id])
  @@index([planetId, mentionsEveryone, createdAt])
  @@index([mentionedProfileIds], type: Gin)
  @@index([authorId, createdAt])
}

model PlanetChatReadState {
  id         String      @id @default(cuid())
  planetId   String
  profileId  String
  lastReadAt DateTime    @default(now())
  mutedAt    DateTime?
  pinnedAt   DateTime?
  hiddenAt   DateTime?
  planet     Planet      @relation(fields: [planetId], references: [id], onDelete: Cascade)
  profile    UserProfile @relation("PlanetChatReadStateProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([planetId, profileId])
  @@index([profileId, mutedAt])
  @@index([profileId, pinnedAt])
  @@index([profileId, hiddenAt])
  @@index([profileId, updatedAt])
  @@index([planetId, lastReadAt])
}

model PlanetMoment {
  id        String                @id @default(cuid())
  planetId  String
  authorId  String
  content   String                @db.Text
  imageUrls String[]              @default([])
  planet    Planet                @relation(fields: [planetId], references: [id], onDelete: Cascade)
  author    UserProfile           @relation("PlanetMomentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments  PlanetMomentComment[]
  likes     PlanetMomentLike[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([planetId, createdAt])
  @@index([authorId, createdAt])
}

model PlanetMomentComment {
  id        String                    @id @default(cuid())
  momentId  String
  authorId  String
  content   String                    @db.Text
  moment    PlanetMoment              @relation(fields: [momentId], references: [id], onDelete: Cascade)
  author    UserProfile               @relation("PlanetMomentCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes     PlanetMomentCommentLike[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([momentId, createdAt])
  @@index([authorId, createdAt])
}

model PlanetMomentLike {
  id        String       @id @default(cuid())
  momentId  String
  profileId String
  moment    PlanetMoment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  profile   UserProfile  @relation("PlanetMomentLikeProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([momentId, profileId])
  @@index([profileId, createdAt])
}

model PlanetMomentCommentLike {
  id        String              @id @default(cuid())
  commentId String
  profileId String
  comment   PlanetMomentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  profile   UserProfile         @relation("PlanetCommentLikeProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@unique([commentId, profileId])
  @@index([profileId, createdAt])
}

model MobileDevice {
  id            String         @id @default(cuid())
  userProfileId String
  userProfile   UserProfile    @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  platform      MobilePlatform
  fcmToken      String         @unique
  deviceId      String?
  appVersion    String?
  locale        String?
  timezone      String?
  userAgent     String?
  lastSeenAt    DateTime       @default(now())
  disabledAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userProfileId, disabledAt, lastSeenAt])
  @@index([platform, deviceId])
}

model Activity {
  id                String                     @id @default(cuid())
  title             String
  description       String
  itinerary         String?
  type              ActivityType               @default(LOCAL)
  category          ActivityCategory           @default(OTHER)
  city              String                     @default("Paris")
  destination       String?
  address           String
  latitude          Float?
  longitude         Float?
  startAt           DateTime
  endAt             DateTime?
  capacity          Int
  minParticipants   Int?
  requiresApproval  Boolean                    @default(false)
  priceType         PriceType                  @default(FREE)
  priceText         String
  coverImageUrl     String?
  ticketUrl         String?
  ticketLabel       String?
  source            String?
  sourceUrl         String?                    @unique
  externalSource    String?
  externalId        String?
  externalUrl       String?
  sourcePayload     Json?
  importedAt        DateTime?
  status            ActivityStatus             @default(RECRUITING)
  visibility        ActivityVisibility         @default(PUBLIC)
  shareEnabled      Boolean                    @default(false)
  shareToken        String?                    @unique
  organizerId       String
  organizer         UserProfile                @relation("ActivityOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  publicEventId     String?
  publicEvent       PublicEvent?               @relation(fields: [publicEventId], references: [id], onDelete: SetNull)
  merchantId        String?
  merchant          Merchant?                  @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  participants      ActivityParticipant[]
  guestParticipants GuestActivityParticipant[]
  comments          Comment[]
  notifications     Notification[]
  sourceLinks       ActivitySourceLink[]
  favorites         ActivityFavorite[]
  coManagers        ActivityCoManager[]
  managementLogs    ActivityManagementLog[]
  roomMessages      ActivityRoomMessage[]
  roomReadStates    ActivityRoomReadState[]
  directMessages    DirectMessage[]
  announcements     ActivityAnnouncement[]
  trustScoreEvents  TrustScoreEvent[]
  aaLedger          AaLedger?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([city, startAt])
  @@index([city, latitude, longitude])
  @@index([organizerId])
  @@index([publicEventId, status, startAt])
  @@index([merchantId])
  @@index([source])
  @@index([externalSource, externalId])
  @@index([externalUrl])
  @@index([ticketUrl])
  @@index([importedAt])
}

model ActivityCoManager {
  id               String       @id @default(cuid())
  activityId       String
  managerProfileId String
  addedByProfileId String?
  activity         Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  manager          UserProfile  @relation("ActivityCoManagerProfile", fields: [managerProfileId], references: [id], onDelete: Cascade)
  addedBy          UserProfile? @relation("ActivityCoManagerAddedBy", fields: [addedByProfileId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@unique([activityId, managerProfileId])
  @@index([managerProfileId])
  @@index([addedByProfileId])
}

model ActivityManagementLog {
  id         String       @id @default(cuid())
  activityId String
  actorId    String?
  action     String
  metadata   Json?
  activity   Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  actor      UserProfile? @relation("ActivityManagementLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([activityId, createdAt])
  @@index([actorId, createdAt])
}

model ActivityRoomMessage {
  id                  String       @id @default(cuid())
  activityId          String
  senderId            String
  body                String       @db.Text
  imageUrls           String[]     @default([])
  mentionedProfileIds String[]     @default([])
  mentionLabels       String[]     @default([])
  mentionsEveryone    Boolean      @default(false)
  deletedAt           DateTime?
  deletedById         String?
  activity            Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sender              UserProfile  @relation("ActivityRoomMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletedBy           UserProfile? @relation("ActivityRoomMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([activityId, createdAt])
  @@index([activityId, createdAt, id])
  @@index([activityId, updatedAt])
  @@index([activityId, mentionsEveryone, createdAt])
  @@index([mentionedProfileIds], type: Gin)
  @@index([senderId, createdAt])
  @@index([deletedById])
}

model ActivityRoomReadState {
  id                 String      @id @default(cuid())
  activityId         String
  profileId          String
  lastReadAt         DateTime    @default(now())
  mutedAt            DateTime?
  pinnedAt           DateTime?
  hiddenAt           DateTime?
  announcementReadAt DateTime?
  activity           Activity    @relation(fields: [activityId], references: [id], onDelete: Cascade)
  profile            UserProfile @relation("ActivityRoomReadStateProfile", fields: [profileId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([activityId, profileId])
  @@index([profileId, mutedAt])
  @@index([profileId, pinnedAt])
  @@index([profileId, hiddenAt])
  @@index([profileId, updatedAt])
  @@index([activityId, lastReadAt])
}

model PublicEvent {
  id             String                @id @default(cuid())
  title          String
  description    String
  category       ActivityCategory      @default(OTHER)
  city           String                @default("Paris")
  address        String
  latitude       Float?
  longitude      Float?
  startAt        DateTime
  endAt          DateTime?
  priceType      PriceType             @default(FREE)
  priceText      String?
  coverImageUrl  String?
  officialUrl    String?
  ticketUrl      String?
  ticketLabel    String?
  status         PublicEventStatus     @default(SCHEDULED)
  visibility     ActivityVisibility    @default(PUBLIC)
  source         String?
  sourceUrl      String?               @unique
  externalSource String?
  externalId     String?
  externalUrl    String?
  sourcePayload  Json?
  importedAt     DateTime?
  lastSyncedAt   DateTime?
  teams          Activity[]
  favorites      PublicEventFavorite[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([city, startAt])
  @@index([status, startAt])
  @@index([visibility, startAt])
  @@index([externalSource, externalId])
  @@index([externalUrl])
  @@index([ticketUrl])
  @@index([importedAt])
}

model ActivityPriorityOverride {
  id             String                     @id @default(cuid())
  targetType     ActivityPriorityTargetType
  targetId       String
  initialBoost   Int                        @default(0)
  boostStartedAt DateTime
  boostExpiresAt DateTime?
  note           String?                    @db.VarChar(240)
  updatedById    String?
  updatedBy      UserProfile?               @relation("ActivityPriorityOverrideUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([targetType, targetId])
  @@index([targetType, boostExpiresAt])
  @@index([targetType, updatedAt])
  @@index([updatedById, updatedAt])
}

model ActivityPriorityOverrideLog {
  id         String                     @id @default(cuid())
  targetType ActivityPriorityTargetType
  targetId   String
  oldBoost   Int                        @default(0)
  newBoost   Int                        @default(0)
  note       String?                    @db.VarChar(240)
  actorId    String?
  actor      UserProfile?               @relation("ActivityPriorityOverrideLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime                   @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}

model Merchant {
  id             String     @id @default(cuid())
  slug           String     @unique
  name           String
  description    String
  logoUrl        String?
  city           String     @default("Paris")
  address        String?
  latitude       Float?
  longitude      Float?
  websiteUrl     String?
  contactEmail   String?
  externalSource String?
  externalId     String?
  externalUrl    String?
  sourcePayload  Json?
  importedAt     DateTime?
  isActive       Boolean    @default(true)
  activities     Activity[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive, city])
  @@index([externalSource, externalId])
  @@index([externalUrl])
  @@index([importedAt])
}

model TopNewsItem {
  id                 String   @id @default(cuid())
  slug               String   @unique
  titleZh            String
  titleEn            String
  titleFr            String
  href               String
  imageUrl           String
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdByProfileId String?
  updatedByProfileId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([updatedAt])
}

model ActivitySourceLink {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
