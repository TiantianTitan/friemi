  categoryId                String?
  category                  AaCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryNameSnapshot      String                  @default("其他") @db.VarChar(60)
  type                      AaTransactionType
  status                    AaTransactionStatus     @default(POSTED)
  splitMode                 AaSplitMode?
  title                     String                  @db.VarChar(120)
  note                      String?                 @db.Text
  originalCurrency          String                  @db.Char(3)
  originalAmountMinor       BigInt
  baseAmountMinor           BigInt
  fxRate                    Decimal                 @default(1) @db.Decimal(24, 12)
  fxRateSource              String?                 @db.VarChar(80)
  fxRateDate                DateTime?
  occurredAt                DateTime
  creatorParticipantId      String
  creator                   AaParticipant           @relation("AaTransactionCreator", fields: [creatorParticipantId], references: [id], onDelete: Restrict)
  reviewedByParticipantId   String?
  reviewer                  AaParticipant?          @relation("AaTransactionReviewer", fields: [reviewedByParticipantId], references: [id], onDelete: SetNull)
  reviewedAt                DateTime?
  rejectionReason           String?                 @db.VarChar(240)
  transferFromParticipantId String?
  transferFrom              AaParticipant?          @relation("AaTransferSender", fields: [transferFromParticipantId], references: [id], onDelete: Restrict)
  transferToParticipantId   String?
  transferTo                AaParticipant?          @relation("AaTransferRecipient", fields: [transferToParticipantId], references: [id], onDelete: Restrict)
  payerConfirmedById        String?
  payerConfirmer            AaParticipant?          @relation("AaTransferPayerConfirmer", fields: [payerConfirmedById], references: [id], onDelete: SetNull)
  payerConfirmedAt          DateTime?
  payeeConfirmedById        String?
  payeeConfirmer            AaParticipant?          @relation("AaTransferPayeeConfirmer", fields: [payeeConfirmedById], references: [id], onDelete: SetNull)
  payeeConfirmedAt          DateTime?
  clientMutationId          String?                 @unique @db.VarChar(120)
  importSource              String?                 @db.VarChar(40)
  importRecordId            String?                 @db.VarChar(160)
  version                   Int                     @default(1)
  voidedAt                  DateTime?
  voidedByParticipantId     String?
  voidedBy                  AaParticipant?          @relation("AaTransactionVoider", fields: [voidedByParticipantId], references: [id], onDelete: SetNull)
  contributions             AaContribution[]
  shares                    AaShare[]
  attachments               AaAttachment[]
  revisions                 AaTransactionRevision[]
  changeRequests            AaChangeRequest[]
  conflicts                 AaConflict[]
  linkedPaymentRequest      AaPaymentRequest?       @relation("AaPaymentRequestTransfer")
  auditEvents               AaAuditEvent[]
  notifications             Notification[]
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  @@unique([ledgerId, importSource, importRecordId])
  @@index([ledgerId, occurredAt, id])
  @@index([ledgerId, status, updatedAt])
  @@index([creatorParticipantId, createdAt])
  @@index([transferFromParticipantId])
  @@index([transferToParticipantId])
}

