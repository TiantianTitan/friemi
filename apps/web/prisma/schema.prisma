  joinedAt                   DateTime                  @default(now())
  inactivatedAt              DateTime?
  contributions              AaContribution[]
  shares                     AaShare[]
  createdTransactions        AaTransaction[]           @relation("AaTransactionCreator")
  reviewedTransactions       AaTransaction[]           @relation("AaTransactionReviewer")
